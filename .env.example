# PostgreSQL
POSTGRES_DB=docsynth
POSTGRES_USER=docsynth
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docsynth:change-this-local-password@localhost:5432/docsynth?schema=public

# MinIO
MINIO_ROOT_USER=docsynth
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=docsynth-pdfs
S3_ACCESS_KEY=docsynth
S3_SECRET_KEY=change-this-minio-password

# Redis job queue
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OCR service
OCR_BASE_URL=http://localhost:8081/v1
OCR_API_KEY=not-needed
OCR_MODEL=glm-ocr
OCR_DPI=250
OCR_MAX_TOKENS=4096
SUMMARY_MODEL=ternary-bonsai-27B

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# Optional worker logging level
LOG_LEVEL=INFO

# Optional telemetry; leave empty to disable Nest Observe locally
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
